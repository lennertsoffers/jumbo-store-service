### 13. Unknown HTTP method on the collection endpoint
POST {{baseUrl}}/api/v1/stores?latitude={{latitude}}&longitude={{longitude}}
Accept: application/json

> {%
    client.test("Status is 405 Method Not Allowed", function() {
        client.assert(response.status === 405, "Expected 405 but got " + response.status);
    });
%}

### 14. Unknown route
GET {{baseUrl}}/api/v1/unknown
Accept: application/json

> {%
    client.test("Status is 404 Not Found", function() {
        client.assert(response.status === 404, "Expected 404 but got " + response.status);
    });
%}
